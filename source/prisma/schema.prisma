generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  READER
  EDITOR
  ADMIN
}

enum Department {
  CPE
  SKE
}

enum ItemType {
  NEWS
  OPPORTUNITY
  ACTIVITY
  ALERT
  DOCUMENT
}

enum Visibility {
  PUBLIC
  KU_ONLY
}

/// เพิ่ม PAST และ HIDDEN ใน iteration 2
/// PAST   จบแล้ว ออกจากฟีดปัจจุบัน แต่ยังค้นหาเจอ  (SRS-18, SRS-24)
/// HIDDEN ซ่อนถาวร ใช้เมื่อโพสต์ผิด หายจากทุกที่ แต่ยังอยู่ในมุมมองผู้ดูแล  (SRS-20)
enum ItemStatus {
  DRAFT
  PUBLISHED
  PAST
  HIDDEN
}

/// ใช้ enum เพื่อไม่ให้มีค่าที่สะกดผิดเข้ามาในบันทึก
enum AuditAction {
  CREATE
  UPDATE
  PUBLISH
  MARK_PAST
  EXTEND
  HIDE
  ROLE_CHANGE
  ATTACH
}

model User {
  id         String      @id @default(cuid())
  email      String      @unique
  name       String?
  image      String?
  role       Role        @default(READER)
  department Department?
  year       Int?
  createdAt  DateTime    @default(now())

  items ContentItem[]
  audit AuditLog[]
}

model Allowlist {
  email String  @id
  role  Role    @default(EDITOR)
  note  String?
}

model ContentItem {
  id         String     @id @default(cuid())
  title      String
  body       String
  type       ItemType   @default(NEWS)
  department Department
  visibility Visibility @default(KU_ONLY)
  status     ItemStatus @default(DRAFT)

  details Json?

  eventStart DateTime?
  expiresAt  DateTime?
  pinned     Boolean   @default(false)

  imageUrl String?

  parentId String?
  parent   ContentItem?  @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  children ContentItem[] @relation("Thread")

  attachments Attachment[]
  audit       AuditLog[]

  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, visibility])
  @@index([parentId])
  @@index([expiresAt])
}

/// เก็บเฉพาะข้อมูลอ้างอิง ตัวไฟล์อยู่ใน object store
/// ถ้าเก็บไฟล์ในฐานข้อมูล ฐานข้อมูลจะโตเกินจำเป็นและทุกการดาวน์โหลดต้องผ่านแอป
model Attachment {
  id         String      @id @default(cuid())
  itemId     String
  item       ContentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  size       Int
  storageKey String      @unique
  createdAt  DateTime    @default(now())

  @@index([itemId])
}

/// SRS-21 บันทึกทุกการเขียน ลบจากหน้าเว็บไม่ได้
/// itemId เป็น optional เพราะการเปลี่ยนสิทธิ์ไม่ได้ผูกกับประกาศใด
model AuditLog {
  id        String       @id @default(cuid())
  actorId   String
  actor     User         @relation(fields: [actorId], references: [id])
  itemId    String?
  item      ContentItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  action    AuditAction
  detail    String?
  createdAt DateTime     @default(now())

  @@index([createdAt])
  @@index([itemId])
}
