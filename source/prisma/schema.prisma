generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  READER
  EDITOR
  ADMIN
}

enum Program {
  CPE
  SKE
}

enum Audience {
  ALL
  CPE
  SKE
  CPE_SKE
}

enum ItemType {
  NEWS
  OPPORTUNITY
  ACTIVITY
  ALERT
  DOCUMENT
}

enum Visibility {
  PUBLIC
  KU_ONLY
}

enum ItemStatus {
  DRAFT
  PUBLISHED
  PAST
  HIDDEN
}

enum AuditAction {
  CREATE
  UPDATE
  PUBLISH
  MARK_PAST
  EXTEND
  HIDE
  ROLE_CHANGE
  ATTACH
  DETACH
  PIN
  UNPIN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  role      Role     @default(READER)
  program   Program?
  year      Int?
  createdAt DateTime @default(now())

  items      ContentItem[]
  savedItems SavedItem[]
  audit      AuditLog[]
}

model Allowlist {
  email String  @id
  role  Role    @default(EDITOR)
  note  String?
}

model ContentItem {
  id         String     @id @default(cuid())
  title      String
  body       String
  type       ItemType   @default(NEWS)
  audience   Audience   @default(ALL)
  targetYear Int?
  visibility Visibility @default(KU_ONLY)
  status     ItemStatus @default(DRAFT)

  details Json?

  publishedAt DateTime?
  eventStart  DateTime?
  eventEnd    DateTime?
  expiresAt   DateTime?
  location    String?
  pinned      Boolean   @default(false)

  parentId String?
  parent   ContentItem?  @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  children ContentItem[] @relation("Thread")

  attachments Attachment[]
  savedBy     SavedItem[]
  audit       AuditLog[]

  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, visibility])
  @@index([parentId])
  @@index([audience])
  @@index([targetYear])
  @@index([eventStart])
  @@index([expiresAt])
}

model Attachment {
  id         String      @id @default(cuid())
  itemId     String
  item       ContentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  size       Int
  storageKey String      @unique
  createdAt  DateTime    @default(now())

  @@index([itemId])
}

model SavedItem {
  userId String
  itemId String

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ContentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, itemId])
  @@index([itemId])
}

model AuditLog {
  id        String       @id @default(cuid())
  actorId   String
  actor     User         @relation(fields: [actorId], references: [id])
  itemId    String?
  item      ContentItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  action    AuditAction
  detail    String?
  createdAt DateTime     @default(now())

  @@index([createdAt])
  @@index([itemId])
}
