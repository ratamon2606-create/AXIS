{
  "name": "dept-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run security:gate && prisma generate && next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run security:gate && npm run quality:comments && npm run typecheck && npm test && npm run build",
    "security:gate": "node scripts/check-security.mjs",
    "quality:comments": "node scripts/check-comments.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@prisma/client": "5.22.0",
    "next": "15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.15",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "^2.1.9"
  }
}
