# Copy to .env and replace all placeholder passwords / OAuth values.
# This is a local-development template, NOT a production secrets file.
POSTGRES_USER=hub
POSTGRES_DB=hub
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
MINIO_ROOT_USER=REPLACE_WITH_LOCAL_MINIO_USERNAME
MINIO_ROOT_PASSWORD=REPLACE_WITH_LOCAL_MINIO_PASSWORD

# URL-encode special characters in the database password.
DATABASE_URL=postgresql://hub:REPLACE_WITH_LOCAL_DATABASE_PASSWORD@localhost:5432/hub?schema=public
S3_ENDPOINT=http://127.0.0.1:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=hub-files
S3_REGION=us-east-1
S3_ACCESS_KEY=REPLACE_WITH_LOCAL_MINIO_USERNAME
S3_SECRET_KEY=REPLACE_WITH_LOCAL_MINIO_PASSWORD

AUTH_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
AUTH_GOOGLE_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
AUTH_GOOGLE_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
ALLOWED_EMAIL_DOMAINS=ku.th
# DANGER: destructive seed requires opt-in and is refused in production.
ALLOW_DESTRUCTIVE_SEED=false
